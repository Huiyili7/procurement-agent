# 复制为 .env 并填入。任选一个 OpenAI 兼容供应商：
# DeepSeek:  base=https://api.deepseek.com/v1     model=deepseek-chat
# 通义千问:  base=https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus
# OpenAI:    base 留空                              model=gpt-4o-mini
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# 数据源：seed=合成数据(默认,可公开) | real=脱敏真实数据(走 .gitignore 的本地文件)
DATA_SOURCE=seed
# DATA_SOURCE=real 时数据文件路径(默认 agent/data/_real/purchase_history.json)
# REAL_DATA_PATH=

# 持久化后端：memory(默认,进程内) | sqlite(落文件,可跨重启续跑) | postgres(生产)
CHECKPOINTER=memory
# CHECKPOINTER_PATH=.checkpoints.sqlite   # sqlite 用
# PG_CONN=postgresql://user:pass@host:5432/db   # postgres 用

# 模型分层(M4)：快模型做工具调用/结构化，深模型做纯推理综合
# DEEP_MODEL_NAME=deepseek-reasoner

# LangSmith 追踪(M5,可选)：设了 key 才启用，全链路 trace
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=procurement-agent
